#!/usr/bin/env bash

progname=${0##*/}
progname=${progname%.sh}
usage() {
  echo "usage: $progname [Options] [ACTION]"
  echo "Options:"
  echo "  -h     : This help text"
  echo "  -a     : Refresh allowlists (default: blocklists)"
  echo "  -f     : Force refresh"
  echo "  -q     : Quiet output"
  echo
  echo "  ACTION:"
  echo "  status  : Print AdGuardHome status"
  echo "  info    : Print DNS Info"
  echo "  stats   : Print AdGuardHome stats"
  echo "  clear   : Clear AdGuardHome cache (default action)"
  echo "  refresh : Refresh Filtering Blocklists/Allowlists (Blocklists by default)"
  echo "  update  : Self-update AdGuardHome"
  exit "${1:-0}"
}

allowlists=false
list=blocklists
force=false
quiet=false
devnull=()
while getopts ":hafq" opt; do
  case $opt in
    a) allowlists=true ; list=allowlists ;;
    f) force=true ;;
    q) quiet=true ; devnull=(-o /dev/null) ;;
    *) usage ;;
  esac
done
shift $((OPTIND -1))

jqcmd="cat"
command -v jq &> /dev/null && jqcmd='jq -r'

if command -v rbw &>/dev/null; then
  adguard_username=$(rbw get -f username "++++Home Apps - Authelia, etc")
  adguard_server=$(rbw get -f "AdGuard Home URI" "++++Home Apps - Authelia, etc")
  adguard_password=$(rbw get -f password "++++Home Apps - Authelia, etc")
  [ -z "$adguard_server" ] && echo "Error: Could not read AdGuard Server from Bitwarden" && exit 1
  [ -z "$adguard_username" ] && echo "Error: Could not read AdGuard Username from Bitwarden" && exit 1
  [ -z "$adguard_password" ] && echo "Error: Could not read AdGuard Password from Bitwarden" && exit 1
else
  echo "Error: rbw command not found"
  exit 1
fi

if [ "$1" = refresh ]; then
  ! $quiet && printf "Updating %s: " "$list"
  if ! curl -sLf "${devnull[@]}" -X POST -d "{ \"allowlist\": $allowlists, \"force\": $force }" \
      -H 'Content-Type: application/json' \
      -H "Authorization: Basic $(printf "%s:%s" "$adguard_username" "$adguard_password"|base64)" \
      "$adguard_server"/control/filtering/refresh; then
    echo
    echo "Error: Refreshing Filtering $list"
    exit 1
  fi
elif [ "$1" = info ]; then
  curl -sLf "${devnull[@]}" -X GET \
    -H "Authorization: Basic $(printf "%s:%s" "$adguard_username" "$adguard_password"|base64)" \
    "$adguard_server"/control/dns_info | $jqcmd
elif [ "$1" = status ]; then
  curl -sLf "${devnull[@]}" -X GET \
    -H "Authorization: Basic $(printf "%s:%s" "$adguard_username" "$adguard_password"|base64)" \
    "$adguard_server"/control/status | $jqcmd
elif [ "$1" = stats ]; then
  curl -sLf "${devnull[@]}" -X GET \
    -H "Authorization: Basic $(printf '%s:%s' "$adguard_username" "$adguard_password"|base64)" \
    "$adguard_server"/control/stats | $jqcmd
elif [ "$1" = update ]; then
  ! $quiet && printf "Performing self-update: "
  if curl -sLf "${devnull[@]}" -X POST -d '{ }' \
    -H 'Content-Type: application/json' \
    -H "Authorization: Basic $(printf '%s:%s' "$adguard_username" "$adguard_password"|base64)" \
    "$adguard_server"/control/update; then
    echo
    echo "Error: Self-updating AdGuardHome"
    exit 1
  fi
  echo
else
  ! $quiet && printf "Clearing cache: "
  if curl -sLf -o /dev/null -X POST \
    -H "Authorization: Basic $(printf '%s:%s' "$adguard_username" "$adguard_password"|base64)" \
    "$adguard_server"/control/cache_clear &> /dev/null; then
    echo
    echo "Error: Clearing the cache failed"
    exit 1
  fi
  sleep .5
  curl -sLf "${devnull[@]}" -X POST \
    -H "Authorization: Basic $(printf '%s:%s' "$adguard_username" "$adguard_password"|base64)" \
    "$adguard_server"/control/cache_clear
  echo
fi
