#!/usr/bin/env bash

# Nagios check script for Docker Compose services
# Returns:
#   0 (OK) - All services running and healthy
#   1 (WARNING) - Some services not running
#   2 (CRITICAL) - Some services unhealthy
#   3 (UNKNOWN) - Script error

TEMPDIR=$(mktemp -d)
trap 'rm -Rf -- "$TEMPDIR"' EXIT
trap 'exit 1' INT TERM

usage() {
  echo "usage: $PROGNAME [Options] [COMPOSE_FILE...|BASE_DIR...]"
  echo "Options:"
  echo "  -i CONTAINER : Ignore container CONTAINER (may be used more than once)"
  echo "                 CONTAINER can be a regular expression (e.g. 'nginx_.*')"
  echo "  -v           : Print verbose messages to stderr"
  exit "${1:-0}"
}

check_compose_file() {
  [[ -z "$1" ]] && { echo "Error: ${FUNCNAME[0]} requires an argument" >&2 ; return 255 ; }
  grep -q "services:" "$1"
}

process_arg() {
  [[ -z "$1" ]] && { echo "Error: ${FUNCNAME[0]} requires an argument" >&2 ; return 255 ; }
  local file_found=false
  if [[ -f "$1" ]]; then
    if check_compose_file "$1"; then
      echo "$1"
      file_found=true
    fi
  else
    for file in compose.yaml compose.yml docker-compose.yaml docker-compose.yml; do
      if [[ -f "$1"/"$file" ]]; then
        if check_compose_file "$1"/"$file"; then
          echo "$1"/"$file"
          file_found=true
        fi
      fi
    done
    if ! $file_found; then
      for file in "$1"/*; do
        [[ ! -d "$file" ]] && continue
        process_arg "$file"
      done
    fi
  fi
}

process_compose_file() {
  [[ -z "$1" ]] && { echo "Error: ${FUNCNAME[0]} requires an argument" >&2 ; return 255 ; }
  local services=() ignore=() out="$TEMPDIR/out.txt" err="$TEMPDIR/err.txt"
  if ! docker compose -f "$1" config --format json > "$out" 2> "$err"; then
    cat "$err" >&2
    return 1
  fi
  mapfile -t services < <(
    jq -r '.services
           | to_entries[]
           | select(.value.labels.docker_compose_health_ignore | tostring != "false")
           | .value.container_name // .key' "$out"
  )
  if (( ${#services[@]} > 0 )); then
    configured_containers=("${configured_containers[@]}" "${services[@]}")
  fi

  mapfile -t ignore < <(
    jq -r '.services
           | to_entries[]
           | select(.value.labels.docker_compose_health_ignore | tostring == "false")
           | .value.container_name // .key' "$out"
  )
  if (( ${#ignore[@]} > 0 )); then
    ignored_containers=("${ignored_containers[@]}" "${ignore[@]}")
  fi
}

main() {
  local OPTIND=1 OPTARG="" opt=""
  local verbose=false ignore_list=()
  for i in "$@"; do [[ "$i" == "--help" ]] && usage; done
  while getopts ":hi:v" opt; do
    case $opt in
      i) ignore_list+=("$OPTARG") ;;
      v) verbose=true ;;
      h) usage ;;
      :) echo "-$OPTARG requires an argument" ; exit 1 ;;
      \?) echo "Unknown option: -$OPTARG" ; exit 1 ;;
    esac
  done
  shift $(( OPTIND - 1 ))

  if (( $# == 0 )) && [[ -z "$COMPOSE_FILE" ]]; then
    usage 1
  fi

  # If no arguments were passed and COMPOSE_FILE is defined, add to arguments
  [[ -n "$COMPOSE_FILE" ]] && set -- "$COMPOSE_FILE" "$@"

  # Loop through passed arguments finding valid compose files
  local compose_files=() arg=""
  for arg in "$@"; do
    local tmp=()
    mapfile -t tmp < <(process_arg "$arg")
    (( ${#tmp[@]} > 0 )) && compose_files=("${compose_files[@]}" "${tmp[@]}")
  done

  # Loop through compose files and find configured containers/services
  local configured_containers=() ignored_containers=() container="" file=""
  for file in "${compose_files[@]}"; do
    process_compose_file "$file"
  done

  # Get a list of running containers with their state and status
  declare -A state status
  eval "$(docker ps --format 'state[{{.Names}}]={{.State}} ; status[{{.Names}}]={{.HealthStatus}}')"

  # Loop through configured containers and make sure each one is running and healthy
  local running=() not_running=() unhealthy=() healthy=()
  for container in "${configured_containers[@]}"; do
    [[ "$container" =~ ^($(IFS="|"; echo "${ignore_list[*]}"))$ ]] && { ignored_containers+=("$container") ; continue ; }
    local is_healthy=true
    if [[ -z "${state[$container]}" || "${state[$container]}" != running ]]; then
      not_running+=("$container")
      is_healthy=false
    elif [[ ! "${status[$container]}" =~ ^(healthy|starting|none)$ ]]; then
      unhealthy+=("$container")
      running+=("$container")
      is_healthy=false
    fi
    $is_healthy && { healthy+=("$container") ; running+=("$container") ; }
  done

  local expected=0
  expected=$(( ${#configured_containers[@]} - ${#ignored_containers[@]} ))

  if $verbose; then
    echo "Configured Containers:" >&2
    printf '%s\n' "${configured_containers[@]}" | nl >&2
    echo >&2
    if (( ${#running[@]} > 0 )); then
      echo "Running Containers:" >&2
      printf '%s\n' "${running[@]}" | nl >&2
      echo >&2
    fi
    if (( ${#healthy[@]} > 0 )); then
      echo "Healthy Containers:" >&2
      printf '%s\n' "${healthy[@]}" | nl >&2
      echo >&2
    fi
    if (( ${#unhealthy[@]} > 0 )); then
      echo "Unhealthy Containers:" >&2
      printf '%s\n' "${unhealthy[@]}" | nl >&2
      echo >&2
    fi
    if (( ${#not_running[@]} > 0 )); then
      echo "Not Running Containers:" >&2
      printf '%s\n' "${not_running[@]}" | nl >&2
      echo >&2
    fi
    if (( ${#ignored_containers[@]} > 0 )); then
      echo "Ignored Containers:" >&2
      printf '%s\n' "${ignored_containers[@]}" | nl >&2
      echo >&2
    fi
  fi

  if (( ${#unhealthy[@]} > 0 )); then
    echo "CRITICAL: ${#unhealthy[@]} unhealthy service(s): ${unhealthy[*]} | running=${#running[@]} expected=$expected healthy=${#healthy[@]} unhealthy=${#unhealthy[@]} ignored=${#ignored_containers[@]}"
    exit 2
  elif (( ${#not_running[@]} > 0 )); then
    echo "CRITICAL: ${#not_running[@]} service(s) not running: ${not_running[*]} | running=${#running[@]} expected=$expected healthy=${#healthy[@]} unhealthy=${#unhealthy[@]} ignored=${#ignored_containers[@]}"
    exit 1
  else
    echo "OK: All $expected services running and healthy | running=${#running[@]} expected=$expected healthy=${#healthy[@]} unhealthy=0 ignored=${#ignored_containers[@]}"
    exit 0
  fi
}

main "$@"
